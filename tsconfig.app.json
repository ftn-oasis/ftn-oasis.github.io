{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,

    /* 絶対パス化 */
    "baseUrl": ".",          // プロジェクトのルートディレクトリを package.json のあるこの階層に設定
    "paths": {
      "@/*": ["./*"],        // プロジェクトルート以下で '@/MyModule' というパスを書いた場合, './Mymodule' というパスに変換されるように設定
      "@src/*": ["./src/*"]  // プロジェクトルート以下で '@src/MyModule' というパスを書いた場合, './src/Mymodule' というパスに変換されるように設定
    }
  },
  "include": ["src"]
}
